# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY — DO NOT prefix with NEXT_PUBLIC_. This key bypasses Row Level
# Security entirely and can read/write/delete ANY row and ANY Storage object
# in the project. It must never be sent to the browser, logged, echoed in an
# error response, or committed anywhere. Used by app/api/account/delete and
# app/api/cron/cleanup-stale-drafts (both Next.js Route Handlers, which run
# server-side). In Vercel, set this as a server-side Environment Variable
# (Project Settings → Environment Variables) — never expose it through
# next.config.ts's `env` option or any NEXT_PUBLIC_ variable. Project
# Settings → API → service_role key in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY — DO NOT prefix with NEXT_PUBLIC_. Any long random string —
# generate one yourself (e.g. `openssl rand -hex 32`); it is not a Supabase
# value. Gates app/api/cron/cleanup-stale-drafts: Vercel automatically sends
# `Authorization: Bearer <this value>` on every request it generates to
# trigger a configured cron job once this env var is set in the Vercel
# project — that header is the entire authorization model for that route.
# Set it as a server-side Environment Variable in Vercel, exactly like
# SUPABASE_SERVICE_ROLE_KEY above. Without it, the cleanup route refuses
# every request (including Vercel's own) rather than running unauthenticated.
CRON_SECRET=
