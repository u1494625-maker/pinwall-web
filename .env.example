# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY — DO NOT prefix with NEXT_PUBLIC_. This key bypasses Row Level
# Security entirely and can read/write/delete ANY row and ANY Storage object
# in the project. It must never be sent to the browser, logged, echoed in an
# error response, or committed anywhere. Used only by app/api/account/delete
# (a Next.js Route Handler, which runs server-side). In Vercel, set this as
# a server-side Environment Variable (Project Settings → Environment
# Variables) — never expose it through next.config.ts's `env` option or any
# NEXT_PUBLIC_ variable. Project Settings → API → service_role key in the
# Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=
